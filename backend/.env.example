# ---- Server ----
NODE_ENV=development
PORT=8080
CORS_ORIGIN=*

# ---- Target store (do not change unless the mock store moves) ----
STORE_BASE_URL=https://demo.inelabteamdev.com
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36

# ---- Supabase (Postgres) ----
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ---- Scraping ----
# Headed mode for the observable screen-recording run (true/false)
SCRAPE_HEADED=false
SCRAPE_SLOW_MO=0
SCRAPE_TIMEOUT_MS=45000
SCRAPE_RETRIES=4
SCRAPE_CONCURRENCY=1
NAV_TIMEOUT_MS=30000
HTTP_TIMEOUT_MS=20000
HTTP_RETRIES=4

# ---- Scheduling ----
# Secret shared with cron-job.org; the cron call must send header: x-cron-secret: <CRON_SECRET>
CRON_SECRET=change-me-to-a-long-random-string
DEFAULT_INTERVAL_MIN=120

# ---- Alerts (bonus) ----
ALERTS_ENABLED=true
PRICE_DROP_PCT=0
# Optional email alerts via SendGrid
SENDGRID_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=price-tracker@example.com

# ---- Catalog cache ----
CATALOG_TTL_MS=900000
